cabal-version:       3.0
name:                haskell-stan-building-blocks
version:             0.1.0.0
synopsis:            various building blocks for stan programs
description:
license:             BSD-3-Clause
author:              Adam Conner-Sax
maintainer:          adam_conner_sax@yahoo.com
copyright:           2025, Adam Conner-Sax
category:            Data
build-type:          Simple
extra-source-files:


common common-options
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-uni-patterns
                       -Wincomplete-record-updates
                       -Wredundant-constraints
                       -Wnoncanonical-monad-instances
                       -fhide-source-paths
                       -Wmissing-export-lists
                       -Wpartial-fields
                       -Wmissing-deriving-strategies
                       -fwrite-ide-info
                       -hiedir=.hie
                       -Wunused-packages
  if impl(ghc >= 9.0)
    ghc-options:       -Winvalid-haddock
  if impl(ghc >= 9.2)
    ghc-options:       -Wredundant-bang-patterns
                       -Woperator-whitespace
  if impl(ghc >= 9.4)
    ghc-options:       -Wredundant-strictness-flags

  default-language:    Haskell2010
  default-extensions:  ConstraintKinds
                       DeriveGeneric
                       DerivingStrategies
                       GeneralizedNewtypeDeriving
                       InstanceSigs
                       KindSignatures
                       LambdaCase
                       OverloadedStrings
                       ScopedTypeVariables
                       StrictData
                       TupleSections
                       TypeApplications

library
  import: common-options
  build-depends: base >= 4.12 && < 5
               , hs-cmdstan >= 0.1 && < 0.4
               , dependent-hashmap >= 0.1.0.1 && < 0.2
               , dependent-sum >= 0.7.0 && < 0.8
               , effectful >= 2.5 && < 3
               , fin >= 0.2 && < 0.4
               , foldl >= 1.4 && < 1.5
               , haskell-stan-language
               , haskell-stan-builder
               , haskell-stan-functions
               , haskell-stan-runner
               , massiv >= 1.0 && < 1.2
               , relude  >=1.0.0 && < 1.3
               , vec >= 0.4 && < 0.6
               , vector > 0.13 && < 0.14

  mixins:  base hiding (Prelude)
         , relude (Relude as Prelude
         , Relude.Extra)
  exposed-modules: Stan.BuildingBlocks
                 , Stan.BuildingBlocks.ArrayHelpers
                 , Stan.BuildingBlocks.CovarianceStructure
                 , Stan.BuildingBlocks.Data
                 , Stan.BuildingBlocks.Misc
                 , Stan.BuildingBlocks.LogLikelihood
                 , Stan.BuildingBlocks.PosteriorPrediction
                 , Stan.BuildingBlocks.PostStratification
                 , Stan.BuildingBlocks.DesignMatrix
                 , Stan.BuildingBlocks.DirichletMultinomial
                 , Stan.BuildingBlocks.Distributions
                 , Stan.BuildingBlocks.Distributions.RealBinomial
                 , Stan.BuildingBlocks.GroupAlpha
                 , Stan.BuildingBlocks.SumToZero
  hs-source-dirs:   src
