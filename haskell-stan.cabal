cabal-version:       3.0
name:                haskell-stan
version:             0.2.0.0
synopsis:            haskell/Stan interface
description:         tools for writing Stan code from haskell, managing Stan's runtime environment, etc.
license:             BSD-3-Clause
author:              Adam Conner-Sax
maintainer:          adam_conner_sax@yahoo.com
copyright:           2025, Adam Conner-Sax
category:            Data
build-type:          Simple
extra-source-files:

common common-options
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-uni-patterns
                       -Wincomplete-record-updates
                       -Wredundant-constraints
                       -Wnoncanonical-monad-instances
                       -fhide-source-paths
                       -Wmissing-export-lists
                       -Wpartial-fields
                       -Wmissing-deriving-strategies
                       -fwrite-ide-info
                       -hiedir=.hie
                       -Wunused-packages
  if impl(ghc >= 9.0)
    ghc-options:       -Winvalid-haddock
  if impl(ghc >= 9.2)
    ghc-options:       -Wredundant-bang-patterns
                       -Woperator-whitespace
  if impl(ghc >= 9.4)
    ghc-options:       -Wredundant-strictness-flags

  default-language:    Haskell2010
  default-extensions:  ConstraintKinds
                       DeriveGeneric
                       DerivingStrategies
                       GeneralizedNewtypeDeriving
                       InstanceSigs
                       KindSignatures
                       LambdaCase
                       OverloadedStrings
                       ScopedTypeVariables
                       StrictData
                       TupleSections
                       TypeApplications

library
  import: common-options
  build-depends: base >= 4.12 && < 5
               , haskell-stan-language >= 0.1 && < 0.2
               , haskell-stan-functions >= 0.1 && < 0.2
               , haskell-stan-builder >= 0.1 && < 0.2
               , haskell-stan-building-blocks >= 0.1 && < 0.2
               , haskell-stan-runner >= 0.1 && < 0.2
               , relude  >=1.0.0 && < 1.3
  mixins:  base hiding (Prelude)
         , relude (Relude as Prelude)
         , relude
  exposed-modules: Stan
                 , Stan.Operators
                 , Stan.Libraries.Language
                 , Stan.Libraries.Functions
                 , Stan.Libraries.Builder
                 , Stan.Libraries.Runner
                 , Stan.Libraries.BuildingBlocks
  hs-source-dirs:   src

executable model-test
   import: common-options
   ghc-options: -Wall -O
   hs-source-dirs: model-test/src
   main-is: Main.hs
   other-modules: Models
                , ModelPaths
                , KnitEnvironment
   build-depends: base
                , bytestring
                , containers
                , effectful
                , foldl
                , haskell-stan
                , hs-cmdstan
                , knit-haskell
                , flat
                , Frames
                , Frames-serialize
                , Frames-streamly
                , lens
                , relude
                , text
                , th-env
                , vector
   mixins:  base hiding (Prelude)
          , relude (Relude as Prelude)
          , relude
   default-language: Haskell2010
