cabal-version:       3.0
name:                haskell-stan-runner
version:             0.1.0.0
synopsis:            Haskell functions to run Stan programs
description:         Configuration, and cache management for running via hs-cmdstan
license:             BSD-3-Clause
author:              Adam Conner-Sax
maintainer:          adam_conner_sax@yahoo.com
copyright:           2025, Adam Conner-Sax
category:            Data
build-type:          Simple
extra-source-files:

flag streamly9
    Description: require streamly >= 0.9
    Manual: True
    Default: False

common common-options
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-uni-patterns
                       -Wincomplete-record-updates
                       -Wredundant-constraints
                       -Wnoncanonical-monad-instances
                       -fhide-source-paths
                       -Wmissing-export-lists
                       -Wpartial-fields
                       -Wmissing-deriving-strategies
                       -fwrite-ide-info
                       -hiedir=.hie
                       -Wunused-packages
  if impl(ghc >= 9.0)
    ghc-options:       -Winvalid-haddock
  if impl(ghc >= 9.2)
    ghc-options:       -Wredundant-bang-patterns
                       -Woperator-whitespace
  if impl(ghc >= 9.4)
    ghc-options:       -Wredundant-strictness-flags

  default-language:    Haskell2010
  default-extensions:  ConstraintKinds
                       DeriveGeneric
                       DerivingStrategies
                       GeneralizedNewtypeDeriving
                       InstanceSigs
                       KindSignatures
                       LambdaCase
                       OverloadedStrings
                       ScopedTypeVariables
                       StrictData
                       TupleSections
                       TypeApplications

library
  import: common-options
  build-depends: base >= 4.12 && < 5
               , aeson >= 1.4 && < 2.3
               , bytestring >= 0.10 && < 0.14
               , containers >= 0.6 && < 0.7
               , colonnade >= 1.2 && < 1.3
               , directory >= 1.3 && < 1.4
--               , effectful  >= 2.5 && < 3
--               , fin >= 0.2 && < 0.4
               , foldl >= 1.4 && < 1.5
               , Frames >= 0.6.1 && < 0.8
               , Frames-streamly >= 0.2.0
               , haskell-stan-builder
               , haskell-stan-language
               , knit-haskell >= 0.9 && < 0.11
               , hs-cmdstan >= 0.1 && < 0.2
               , massiv >= 1.0 && < 1.1
               , megaparsec >= 9.0.0 && < 10.0
               , polysemy >= 1.9 && < 2.0
               , process >= 1.6 && < 1.7
               , relude  >=1.0.0 && < 1.3
               , say >= 0.1 && < 0.2
               , scientific >= 0.3.5 && < 0.4
               , text >= 1.2 && < 2.1
               , vector >= 0.13 && < 0.14
  if flag(streamly9)
    build-depends:
      streamly >=0.9 && <0.11, streamly-core >=0.1.0 && <0.3, streamly-bytestring >=0.2.0 && < 0.3
  else
    build-depends: streamly >=0.8 && <0.9, streamly-bytestring >=0.1.0 && <0.2
  mixins:  base hiding (Prelude)
         , relude (Relude as Prelude
         , Relude.Extra)
  exposed-modules: Stan.Runner
                 , Stan.Runner.Config
                 , Stan.Runner.Process
                 , Stan.Runner.RScripts
                 , Stan.Runner.SamplerCSV
                 , Stan.Runner.Parameters
                 , Stan.Runner.Parameters.Massiv
  hs-source-dirs:   src
