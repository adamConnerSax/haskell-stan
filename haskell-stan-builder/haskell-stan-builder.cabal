cabal-version:       3.0
name:                haskell-stan-builder
version:             0.1.0.0
synopsis:            Tools to assemble a stan program from building blocks
description:         Builder Monad and associated tools for assembling a stan program
license:             BSD-3-Clause
author:              Adam Conner-Sax
maintainer:          adam_conner_sax@yahoo.com
copyright:           2025, Adam Conner-Sax
category:            Data
build-type:          Simple
extra-source-files:


common common-options
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-uni-patterns
                       -Wincomplete-record-updates
                       -Wredundant-constraints
                       -Wnoncanonical-monad-instances
                       -fhide-source-paths
                       -Wmissing-export-lists
                       -Wpartial-fields
                       -Wmissing-deriving-strategies
                       -fwrite-ide-info
                       -hiedir=.hie
                       -Wunused-packages
  if impl(ghc >= 9.0)
    ghc-options:       -Winvalid-haddock
  if impl(ghc >= 9.2)
    ghc-options:       -Wredundant-bang-patterns
                       -Woperator-whitespace
  if impl(ghc >= 9.4)
    ghc-options:       -Wredundant-strictness-flags

  default-language:    Haskell2010
  default-extensions:  ConstraintKinds
                       DeriveGeneric
                       DerivingStrategies
                       GeneralizedNewtypeDeriving
                       InstanceSigs
                       KindSignatures
                       LambdaCase
                       OverloadedStrings
                       ScopedTypeVariables
                       StrictData
                       TupleSections
                       TypeApplications

library
  import: common-options
  build-depends: base >= 4.12 && < 5
               , aeson >= 1.4 && < 2.3
               , bytestring >= 0.10 && < 0.14
               , cereal-vector >= 0.2 && < 0.3
               , containers
               , dependent-hashmap >= 0.1.0.1 && < 0.2
               , dependent-map >= 0.4 && < 0.5
               , dependent-sum >= 0.7.0 && < 0.8
               , effectful >= 2.5 && < 3
               , extra >= 1.7.7 && < 1.9
               , foldl >= 1.4 && < 1.5
               , hashable >= 1.3 && < 1.6
               , haskell-stan-language
               , haskell-stan-functions
               , relude  >=1.0.0 && < 1.3
               , text >= 1.2 && < 2.2
               , vector
               , vector-builder >= 0.3.7 && < 0.4
  mixins:  base hiding (Prelude)
         , relude (Relude as Prelude)
         , relude
  exposed-modules: Stan.Builder
                 , Stan.Builder.Build
                 , Stan.Builder.BuildRunner
                 , Stan.Builder.Core
                 , Stan.Builder.JSON
                 , Stan.Builder.JSON.JSONUtils
                 , Stan.Builder.Parameters
                 , Stan.Builder.Parameters.Types
                 , Stan.Builder.Parameters.Core
                 , Stan.Builder.Data
                 , Stan.Builder.Groups
                 , Stan.Builder.TestUtils
  hs-source-dirs:   src

executable builder-test
   import: common-options
   ghc-options: -Wall -O
   hs-source-dirs: builder-tests
   main-is: Test1.hs
   build-depends: base
                , aeson
                , haskell-stan-language
                , haskell-stan-functions
                , haskell-stan-builder
                , relude
                , text
   mixins:  base hiding (Prelude)
          , relude (Relude as Prelude)
          , relude
   default-language: Haskell2010
