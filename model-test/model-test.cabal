cabal-version:       3.0
name:                model-test
version:             0.1.0.0
synopsis:            haskell/Stan interface test
description:
license:             BSD-3-Clause
author:              Adam Conner-Sax
maintainer:          adam_conner_sax@yahoo.com
-- copyright:
category:            Data
build-type:          Simple
extra-source-files: Readme.md Changelog.md

flag streamly9
    Description: require streamly >= 0.9
    Manual: True
    Default: False


common common-options
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-uni-patterns
                       -Wincomplete-record-updates
                       -Wredundant-constraints
                       -Wnoncanonical-monad-instances
                       -fhide-source-paths
                       -Wmissing-export-lists
                       -Wpartial-fields
                       -Wmissing-deriving-strategies
                       -fwrite-ide-info
                       -hiedir=.hie
                       -Wunused-packages
  if impl(ghc >= 9.0)
    ghc-options:       -Winvalid-haddock
  if impl(ghc >= 9.2)
    ghc-options:       -Wredundant-bang-patterns
                       -Woperator-whitespace
  if impl(ghc >= 9.4)
    ghc-options:       -Wredundant-strictness-flags

  default-language:    Haskell2010
  default-extensions:  ConstraintKinds
                       DeriveGeneric
                       DerivingStrategies
                       GeneralizedNewtypeDeriving
                       InstanceSigs
                       KindSignatures
                       LambdaCase
                       OverloadedStrings
                       ScopedTypeVariables
                       StrictData
                       TupleSections
                       TypeApplications

executable model-test
   import: common-options
   ghc-options: -Wall -O
   hs-source-dirs: src
   main-is: Main.hs
   other-modules: Models
                , ModelPaths
                , KnitEnvironment
   build-depends: base
                , bytestring
                , containers
                , effectful
                , foldl
                , haskell-stan-language
                , haskell-stan-functions
                , haskell-stan-builder
                , haskell-stan-building-blocks
                , haskell-stan-runner
                , hs-cmdstan
                , knit-haskell
                , flat
                , Frames
                , Frames-serialize
                , Frames-streamly
                , lens
                , relude
                , text
                , th-env
                , vector
   mixins:  base hiding (Prelude)
          , relude (Relude as Prelude
          , Relude.Extra)
   default-language: Haskell2010
